    "jobwatch": "dist/cli.js"
  },
  "files": [
    "dist/",
    "example.config.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
